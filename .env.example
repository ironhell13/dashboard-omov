# 1. Supabase Configuration (Free Tier)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Google Drive OAuth (Arsip Otomatis)
# Setup di Google Cloud Console -> OAuth Consent Screen (Status: In Production)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback
GOOGLE_REFRESH_TOKEN=1//0your-refresh-token

# 3. Vercel Cron Security
CRON_SECRET=your-random-cron-secret-key-at-least-32-chars

# 4. App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

